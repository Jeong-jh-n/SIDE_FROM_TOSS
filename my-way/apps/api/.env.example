# ─────────────────────────────────────────────────────────────
# apps/api 환경변수
#
# 이 파일은 템플릿이고 커밋됩니다. 실제 값은 .env 에 넣으세요.
# 자격증명은 이 서버 안에만 존재합니다. 프론트로 내보내지 마세요. (CLAUDE.md §2.1)
# ─────────────────────────────────────────────────────────────

PORT=3000

# ── 배포에서 반드시 채우세요 ──────────────────────────────────
#
# CORS 허용 출처. 쉼표로 여러 개.
# **비워두면 모든 출처를 허용합니다.** 로컬 개발 편의를 위한 기본값이라,
# 배포에서 그대로 두면 아무 사이트나 우리 서버를 통해 커리어넷을 부를 수 있어요.
ALLOWED_ORIGINS=

# 요청 빈도 제한. 창(WINDOW) 당 허용 횟수.
# 검사 하나를 푸는 데 충분한 양으로 잡혀 있어요. 필요하면 조정하세요.
RATE_LIMIT=120
RATE_WINDOW_MS=60000

# ── AI ───────────────────────────────────────────────────────
#
# 어느 제공자를 쓸지. 설정 안 하면 local 입니다.
#   vertex  Vertex AI (서울 리전) — 토스판
#   local   로컬 추론 서버        — 사이드
#
# 배포에서 빠뜨리면 AI 기능이 조용히 빠져요.
# /api/ai/health 가 어느 제공자인지 돌려주니 배포 후 한 번 확인하세요.
AI_PROVIDER=local

# ── AI_PROVIDER=vertex 일 때 ────────────────────────────────
#
# 리전은 여기 없습니다. asia-northeast3(서울)로 **소스에 박혀 있어요.**
# 기본 리전이 us-central1 이라, 환경변수로 두면 값이 비는 순간 미국으로 나갑니다.
# 절대 환경변수로 빼지 마세요. (lib/aiVertex.ts + 테스트가 막고 있습니다)
GOOGLE_CLOUD_PROJECT=

# Vertex API 키. AQ. 로 시작하는 키예요.
# 구글 클라우드 콘솔 → Agent Platform → Studio → API keys 에서 발급합니다.
# **절대 프론트엔드에 두지 마세요.** 브라우저에서 그대로 보입니다.
VERTEX_API_KEY=

# ── AI_PROVIDER=local 일 때 ─────────────────────────────────
#
# 안 띄우면 AI 기능만 조용히 빠지고 앱은 정상 동작합니다.
# **AI허브로 학습한 어댑터를 쓰면 국내에서만 돌려야 합니다.** (db-plan.md)
AI_BASE_URL=http://127.0.0.1:8000
