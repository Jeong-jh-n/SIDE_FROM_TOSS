# ─────────────────────────────────────────────────────────────
# apps/api 환경변수
#
# 이 파일은 템플릿이고 커밋됩니다. 실제 값은 .env 에 넣으세요.
# 커리어넷 키는 이 서버 안에만 존재합니다. 프론트로 내보내지 마세요. (CLAUDE.md §2.1)
# ─────────────────────────────────────────────────────────────

# 커리어넷 Open API. 유효기간 2년 — 만료일을 반드시 기록하세요.
# /api/health 가 이 날짜로 잔여일을 계산하고, 60일 미만이면 warning 을 냅니다.
CAREERNET_API_KEY=
CAREERNET_KEY_EXPIRES_AT=   # ISO date (예: 2028-08-24)

PORT=3000

# ── 배포에서 반드시 채우세요 ──────────────────────────────────
#
# CORS 허용 출처. 쉼표로 여러 개.
# **비워두면 모든 출처를 허용합니다.** 로컬 개발 편의를 위한 기본값이라,
# 배포에서 그대로 두면 아무 사이트나 우리 서버를 통해 커리어넷을 부를 수 있어요.
ALLOWED_ORIGINS=

# 요청 빈도 제한. 창(WINDOW) 당 허용 횟수.
# 검사 하나를 푸는 데 충분한 양으로 잡혀 있어요. 필요하면 조정하세요.
RATE_LIMIT=120
RATE_WINDOW_MS=60000

# ── AI (선택) ────────────────────────────────────────────────
#
# 로컬 추론 서버 주소. 안 띄우면 AI 기능만 조용히 빠지고 앱은 정상 동작합니다.
# **국내에서만 돌려야 합니다.** AI허브 데이터 국외 반출 금지. (db-plan.md)
AI_BASE_URL=http://127.0.0.1:8000
