{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* 경로 별칭 — @ 는 src, @content 는 저장소 루트의 data/ (CLAUDE.md §3) */
    "paths": {
      "@/*": ["./src/*"],
      "@content/*": ["../../data/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* _legacy 는 CLAUDE.md 이전 단계의 코드예요. 빌드 대상이 아니며 참고용으로만 남겨둡니다. */
  "exclude": ["src/_legacy"]
}
